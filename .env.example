MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=manobodha_db

# Google OAuth — get these from https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# The public URL of your app (used for OAuth redirect URI construction)
ORIGIN=http://localhost:5173


# Admin / Creator Emails (comma-separated)
ADMIN_EMAILS=creator1@example.com,creator2@example.com
